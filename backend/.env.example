# ════════════════════════════════════════════════════
# Cooperative AI Assistant — Backend Environment
# ════════════════════════════════════════════════════
#
# 1. Copy this file:   cp .env.example .env
# 2. Fill in values below
# 3. NEVER commit .env to git — it is gitignored
#
# ════════════════════════════════════════════════════

# ── Gemini AI ─────────────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
# NEVER expose this key in frontend code or VITE_ variables.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase ──────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# WARNING: Never expose this key to the frontend or public repos.
SUPABASE_SERVICE_ROLE_KEY=

# ── CORS ──────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── General ───────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
