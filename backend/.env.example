# ════════════════════════════════════════════════════
# SahkaarSetu (SIH26088) — Backend Environment Example
# ════════════════════════════════════════════════════
# 1. Copy this file:   cp .env.example .env
# 2. Fill in values below
# 3. NEVER commit .env to git — it is gitignored
# ════════════════════════════════════════════════════

# ── Groq AI Provider (Primary LLM Engine) ───────────
GROQ_API_KEY=your_groq_api_key_here

# ── Gemini AI Provider (Optional / Vector Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Bhashini Multilingual Speech Services ───────────
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id_here

# ── Supabase Database & Vector Storage ──────────────
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── CORS Allowed Origins ────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://pranavkedar87.github.io,*

# ── Application Environment ─────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
