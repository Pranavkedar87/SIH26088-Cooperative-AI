# Cooperative AI Assistant — Frontend Environment
# ════════════════════════════════════════════════════
#
# Copy to .env.local (never commit .env.local)
#
# Vite exposes only VITE_* prefixed variables to the browser.
# NEVER put Supabase service-role keys or Gemini keys here.
#
# ════════════════════════════════════════════════════

# URL of the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000
